// =============================================================
// Nova CRM — Prisma schema
// PostgreSQL (Supabase). Run: pnpm db:push  &&  pnpm db:seed
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Global app configuration (singleton, public-facing toggles)
// -------------------------------------------------------------

model AppConfig {
  id           String   @id @default("singleton")
  heroVersion  String   @default("v1") // "v1" | "v2" — controls the public landing hero
  geminiApiKey String?  // Gemini API key (server-only; never sent to the client)
  geminiModel  String?  // e.g. "gemini-2.5-flash"
  updatedAt    DateTime @updatedAt
}

// -------------------------------------------------------------
// Tenancy & Identity
// -------------------------------------------------------------

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  industry     String?
  country      String?
  currency     String   @default("INR")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  territories     Territory[]
  businessUnits   BusinessUnit[]
  customers       Customer[]
  leads           Lead[]
  opportunities   Opportunity[]
  rfqs            RFQ[]
  quotations      Quotation[]
  manpowerRates   ManpowerRateCard[]
  nonManpowerRates NonManpowerRateCard[]
  licenseRates    LicenseRateCard[]
  approvalChains  ApprovalChain[]
  notifications   Notification[]
  activities      Activity[]
  documents       Document[]
  auditLogs       AuditLog[]
  fieldConfigs       FieldConfig[]
  activityTypeConfigs ActivityTypeConfig[]
  methodologies       Methodology[]
  transformationTypes TransformationType[]
  projects            Project[]
  pipelineGateConfig  PipelineGateConfig?
  rolePermissions     RolePermission[]
}

// -------------------------------------------------------------
// Frontend-configurable field & activity master data
// -------------------------------------------------------------

model FieldConfig {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  module     String  // LEAD | OPPORTUNITY | CUSTOMER | QUOTATION | RFQ | ACTIVITY
  fieldKey   String
  label      String
  active     Boolean @default(true)
  required   Boolean @default(false)
  position   Int     @default(0)
  isCustom   Boolean @default(false)
  fieldType  String  @default("text") // text|textarea|number|date|email|phone|select|currency
  options    Json?   // for select fields: string[]
  appliesTo  Json?   // ACTIVITY module only: activity-type keys this field applies to (null/[] = all types)
  helpText   String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([organizationId, module, fieldKey])
  @@index([organizationId, module])
}

model ActivityTypeConfig {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key       String  // CALL | MEETING | EMAIL | FOLLOW_UP | TASK | NOTE
  label     String
  icon      String  @default("Activity")
  color     String  @default("#64748b")
  active    Boolean @default(true)
  position  Int     @default(0)

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum UserRole {
  // Active taxonomy
  SUPER_USER    // access to everything
  SUPER_ADMIN   // access to everything + grants access to others
  ADMIN         // client-side admin — access granted via the matrix
  SALES_OWNER   // general sales owner
  SALES_HEAD
  BUSINESS_HEAD
  FINANCE_ANALYST
  FINANCE_HEAD
  // Legacy values (Postgres enums are add-only; kept so old rows never break,
  // no longer offered in the UI)
  SALES_EXEC
  SALES_MANAGER
  FINANCE
  REVENUE_OWNER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  // Onboarded employees get a one-time temp password and must set their own.
  mustChangePassword Boolean @default(false)
  name          String?
  image         String?
  mobile        String?
  role          UserRole  @default(SALES_EXEC)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  // Localization preference (persists in Supabase, restores across devices).
  // uiLanguage = the full-UI language code ("en" | "ar" | …); bilingualSecondary
  // = optional script shown beside headings ("none" | "ur" | "ar").
  uiLanguage         String @default("en")
  bilingualSecondary String @default("none")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  accounts      Account[]
  sessions      Session[]
  otpTokens     OtpToken[]
  ownedLeads        Lead[]         @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OppOwner")
  ownedProjects     Project[]      @relation("ProjectOwner")
  assignedDeliverables ProjectDeliverable[] @relation("DeliverableOwner")
  raidItems            ProjectRaidItem[]    @relation("RaidOwner")
  revenueOpportunities Opportunity[] @relation("OppRevenueOwner")
  approvalsRequested ApprovalRequest[] @relation("RequestedBy")
  approvalsApproved  ApprovalStep[]    @relation("ApproverUser")
  activities       Activity[]
  notifications    Notification[]
  documents        Document[]

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Device session tracking
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String?
  identifier String  // email or mobile
  channel   String  // EMAIL | SMS
  code      String  // hashed
  expires   DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
}

// -------------------------------------------------------------
// Org structure
// -------------------------------------------------------------

model Territory {
  id             String  @id @default(cuid())
  name           String
  region         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  leads          Lead[]
  opportunities  Opportunity[]

  @@unique([organizationId, name])
}

model BusinessUnit {
  id             String  @id @default(cuid())
  name           String
  code           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  opportunities  Opportunity[]

  @@unique([organizationId, name])
}

// -------------------------------------------------------------
// Customers
// -------------------------------------------------------------

model Customer {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  industry       String?
  billingAddress String?
  shippingAddress String?
  gstNumber      String?
  country        String?
  region         String?
  website        String?
  data           Json?    // values for admin-defined custom fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  rfqs           RFQ[]
  quotations     Quotation[]
  projects       Project[]

  @@index([organizationId])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  designation String?
  email      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// -------------------------------------------------------------
// Leads
// -------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
  CANCELLED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL_CAMPAIGN
  EVENT
  PARTNER
  SOCIAL
  OTHER
}

model Lead {
  id             String     @id @default(cuid())
  leadNumber     String     @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  company        String
  contactPerson  String?
  email          String?
  mobile         String?
  source         LeadSource @default(WEBSITE)
  industry       String?
  notes          String?    @db.Text
  status         LeadStatus @default(NEW)
  expectedRevenue Decimal?   @db.Decimal(14, 2)
  data           Json?      // values for admin-defined custom fields

  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])

  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id])

  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])

  convertedOpportunityId String?  @unique
  convertedOpportunity   Opportunity? @relation("LeadToOpp", fields: [convertedOpportunityId], references: [id])

  // Controlled cancellation (lifecycle governance). Audit holds the full trail.
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelReason       String?   @db.Text
  statusBeforeCancel String?

  activities     Activity[]
  documents      Document[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, status])
}

// -------------------------------------------------------------
// Opportunity & Pipeline
// -------------------------------------------------------------

enum OpportunityStage {
  QUALIFICATION
  DISCOVERY
  REQUIREMENT_ANALYSIS
  PROPOSAL_SUBMITTED
  RFQ_RECEIVED
  QUOTATION_SENT
  NEGOTIATION
  MANAGEMENT_APPROVAL
  VERBAL_CONFIRMATION
  WON
  LOST
  CANCELLED
}

model Opportunity {
  id               String   @id @default(cuid())
  oppNumber        String   @unique
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])

  ownerId          String?
  owner            User?    @relation("OppOwner", fields: [ownerId], references: [id])

  revenueOwnerId   String?
  revenueOwner     User?    @relation("OppRevenueOwner", fields: [revenueOwnerId], references: [id])

  territoryId      String?
  territory        Territory? @relation(fields: [territoryId], references: [id])

  businessUnitId   String?
  businessUnit     BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  expectedRevenue  Decimal  @default(0) @db.Decimal(14, 2)
  probability      Int      @default(20) // 0–100
  expectedCloseDate DateTime?
  stage            OpportunityStage @default(QUALIFICATION)
  stageEnteredAt   DateTime @default(now())
  lostReason       String?

  // Controlled cancellation (distinct from LOST). Audit holds the full trail.
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelReason       String?  @db.Text
  statusBeforeCancel String?
  notes            String?  @db.Text
  data             Json?    // values for admin-defined custom fields

  fromLead         Lead?    @relation("LeadToOpp")
  rfqs             RFQ[]
  quotations       Quotation[]
  activities       Activity[]
  documents        Document[]
  project          Project?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, stage])
  @@index([customerId])
}

// -------------------------------------------------------------
// RFQ
// -------------------------------------------------------------

enum RFQStatus {
  DRAFT
  RECEIVED
  IN_PROGRESS
  QUOTED
  CLOSED
  CANCELLED
}

enum RFQLineType {
  MANPOWER
  NON_MANPOWER
  SOFTWARE_LICENSE
  HARDWARE
  SERVICE
}

model RFQ {
  id              String    @id @default(cuid())
  rfqNumber       String    @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])

  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])

  rfqDate         DateTime  @default(now())
  dueDate         DateTime?
  currency        String    @default("INR")
  terms           String?   @db.Text
  remarks         String?   @db.Text
  status          RFQStatus @default(DRAFT)
  data            Json?     // values for admin-defined custom fields

  // Controlled cancellation (lifecycle governance).
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelReason       String?  @db.Text
  statusBeforeCancel String?

  lineItems       RFQLineItem[]
  quotations      Quotation[]
  documents       Document[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, status])
}

model RFQLineItem {
  id          String      @id @default(cuid())
  rfqId       String
  rfq         RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineType    RFQLineType
  description String
  quantity    Decimal     @default(1) @db.Decimal(14, 2)
  uom         String?     // hours/days/months/units
  // optional pointers to rate-card structures
  manpowerGrade String?
  manpowerExperience String?
  licenseProduct String?
  notes       String?
  position    Int         @default(0)
}

// -------------------------------------------------------------
// Rate Cards
// -------------------------------------------------------------

model ManpowerRateCard {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  designation    String   // Junior Dev / Sr Dev / Architect / QA / PM / BA …
  experience     String   // "0-2", "3-5", "6-10", "10+"
  grade          String?
  location       String?
  hourlyRate     Decimal  @db.Decimal(12, 2)
  dailyRate      Decimal  @db.Decimal(12, 2)
  monthlyRate    Decimal  @db.Decimal(14, 2)
  currency       String   @default("INR")
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, designation])
}

model NonManpowerRateCard {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category       String   // Travel / Infrastructure / Cloud / Training / Consulting
  description    String
  unit           String   // per trip / per GB / per hour …
  unitCost       Decimal  @db.Decimal(14, 2)
  tax            Decimal  @default(0) @db.Decimal(5, 2) // %
  marginPct      Decimal  @default(0) @db.Decimal(5, 2)
  currency       String   @default("INR")
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, category])
}

model LicenseRateCard {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  product        String   // Microsoft / Salesforce / Jira / Power BI / SAP
  edition        String?
  licenseType    String   // Subscription / Perpetual / User / Device
  duration       String   // Monthly / Yearly / 3-Year
  cost           Decimal  @db.Decimal(14, 2)
  marginPct      Decimal  @default(0) @db.Decimal(5, 2)
  currency       String   @default("INR")
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, product])
}

// -------------------------------------------------------------
// Quotation
// -------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum QuotationItemType {
  MANPOWER
  NON_MANPOWER
  LICENSE
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  version         Int      @default(1)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfqId           String?
  rfq             RFQ?     @relation(fields: [rfqId], references: [id])

  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])

  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])

  status          QuotationStatus @default(DRAFT)
  draftedByAi     Boolean  @default(false) // created via "Draft with AI"

  // Controlled cancellation (lifecycle governance).
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelReason       String?  @db.Text
  statusBeforeCancel String?
  currency        String   @default("INR")
  validUntil      DateTime?
  notes           String?  @db.Text
  termsAndConditions String? @db.Text
  data            Json?    // values for admin-defined custom fields

  // computed totals (kept on row for fast reads)
  baseCost        Decimal  @default(0) @db.Decimal(14, 2)
  markupAmount    Decimal  @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(14, 2)
  marginPct       Decimal  @default(0) @db.Decimal(6, 2)
  profitAmount    Decimal  @default(0) @db.Decimal(14, 2)

  items           QuotationItem[]
  positions       PositionEstimate[]
  approvalRequest ApprovalRequest?
  documents       Document[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  itemType    QuotationItemType
  description String
  quantity    Decimal  @default(1) @db.Decimal(14, 2)
  uom         String?
  unitCost    Decimal  @db.Decimal(14, 2)
  markupPct   Decimal  @default(0) @db.Decimal(6, 2)
  discountPct Decimal  @default(0) @db.Decimal(6, 2)
  taxPct      Decimal  @default(0) @db.Decimal(6, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(14, 2)

  // manpower context
  manpowerGrade String?
  manpowerExperience String?
  // license context
  licenseProduct String?
  licenseDuration String?

  position    Int      @default(0)
}

// -------------------------------------------------------------
// Position Determination Engine — resource estimation
// -------------------------------------------------------------

model PositionEstimate {
  id          String   @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  designation String
  grade       String?
  experience  String?
  headcount   Int      @default(1)
  durationMonths Decimal @default(1) @db.Decimal(6, 2)
  monthlyRate  Decimal @db.Decimal(14, 2)
  monthlyBilling Decimal @db.Decimal(14, 2)
  cost        Decimal  @db.Decimal(14, 2)
  revenue     Decimal  @db.Decimal(14, 2)
  margin      Decimal  @db.Decimal(14, 2)
  marginPct   Decimal  @db.Decimal(6, 2)
}

// -------------------------------------------------------------
// Approval Workflow
// -------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model ApprovalChain {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  appliesTo      String   // QUOTATION | RFQ ...
  steps          ApprovalChainStep[]

  @@unique([organizationId, name])
}

model ApprovalChainStep {
  id            String   @id @default(cuid())
  chainId       String
  chain         ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  stepNumber    Int
  roleRequired  UserRole
  label         String
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  quotationId   String   @unique
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User     @relation("RequestedBy", fields: [requestedById], references: [id])

  status        ApprovalStatus @default(PENDING)
  currentStep   Int      @default(1)
  notes         String?  @db.Text

  steps         ApprovalStep[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ApprovalStep {
  id            String   @id @default(cuid())
  requestId     String
  request       ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepNumber    Int
  label         String
  roleRequired  UserRole
  approverId    String?
  approver      User?    @relation("ApproverUser", fields: [approverId], references: [id])
  status        ApprovalStatus @default(PENDING)
  comments      String?  @db.Text
  actedAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([requestId, stepNumber])
}

// -------------------------------------------------------------
// Activities (Calls, Meetings, Emails, Follow Ups, Tasks)
// -------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
  OVERDUE
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type           ActivityType
  status         ActivityStatus @default(PLANNED)
  subject        String
  description    String?  @db.Text
  dueAt          DateTime?
  completedAt    DateTime?
  data           Json?    // values for configurable custom activity fields

  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id])

  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, dueAt])
  @@index([opportunityId])
  @@index([leadId])
}

// -------------------------------------------------------------
// Documents
// -------------------------------------------------------------

model Document {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  url            String
  mimeType       String?
  sizeBytes      Int?
  version        Int      @default(1)
  category       String?  // RFQ / SOW / Contract / Quotation / Customer

  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])

  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  rfqId          String?
  rfq            RFQ?     @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  quotationId    String?
  quotation      Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// -------------------------------------------------------------
// Notifications
// -------------------------------------------------------------

enum NotificationType {
  LEAD_NEW
  STAGE_CHANGE
  RFQ_CREATED
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  TASK_DUE
  APPROVAL_PENDING
  SYSTEM
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           NotificationType
  title          String
  body           String?  @db.Text
  url            String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, readAt])
}

// -------------------------------------------------------------
// Audit trail — system change history per record (transparent log)
// -------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType  String   // LEAD | OPPORTUNITY | QUOTATION | RFQ
  entityId    String
  entityLabel String?  // e.g. LD-00007 / OPP-00002 / QT-00001
  action      String   // CREATED | UPDATED | STAGE_CHANGED | STATUS_CHANGED | CONVERTED | SUBMITTED | APPROVED | REJECTED | DELETED
  summary     String?  @db.Text
  changes     Json?    // [{ field, from, to }]
  actorId     String?
  actorName   String?
  createdAt   DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}

// -------------------------------------------------------------
// SAP Transformation Intelligence Hub — Projects & Roadmaps
// (methodologies, transformation catalog and pipeline gates are
//  org-configurable master data; projects instantiate a roadmap)
// -------------------------------------------------------------

model Methodology {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String  // e.g. ACTIVATE_S4_PRIVATE
  name        String  // e.g. "SAP Activate — S/4HANA (Private/On-Prem)"
  description String?
  active      Boolean @default(true)
  position    Int     @default(0)

  phases              MethodologyPhase[]
  transformationTypes TransformationType[]
  projects            Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model MethodologyPhase {
  id            String @id @default(cuid())
  methodologyId String
  methodology   Methodology @relation(fields: [methodologyId], references: [id], onDelete: Cascade)

  name          String  // Discover | Prepare | Explore | Realize | Deploy | Run
  description   String?
  color         String  @default("#2563EB")
  durationWeeks Int     @default(4)
  position      Int     @default(0)
  active        Boolean @default(true)

  deliverables MethodologyDeliverable[]

  @@index([methodologyId])
}

model MethodologyDeliverable {
  id       String @id @default(cuid())
  phaseId  String
  phase    MethodologyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  name     String
  position Int     @default(0)
  active   Boolean @default(true)

  @@index([phaseId])
}

model TransformationType {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key           String  // e.g. GREENFIELD_S4_PUBLIC
  name          String  // "Greenfield"
  subtitle      String? // "SAP S/4HANA Public Cloud"
  methodologyId String? // default roadmap for this transformation
  methodology   Methodology? @relation(fields: [methodologyId], references: [id])
  active        Boolean @default(true)
  position      Int     @default(0)

  projects Project[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Project {
  id             String @id @default(cuid())
  projectNumber  String @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  status String @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED

  opportunityId String? @unique
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  transformationTypeId String?
  transformationType   TransformationType? @relation(fields: [transformationTypeId], references: [id])

  methodologyId String?
  methodology   Methodology? @relation(fields: [methodologyId], references: [id])

  ownerId String?
  owner   User? @relation("ProjectOwner", fields: [ownerId], references: [id])

  startDate     DateTime?
  targetEndDate DateTime?
  notes         String? @db.Text
  data          Json?   // values for admin-defined custom fields

  phases    ProjectPhase[]
  raidItems ProjectRaidItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([customerId])
}

model ProjectPhase {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  color         String @default("#2563EB")
  durationWeeks Int    @default(4)
  position      Int    @default(0)
  status        String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  // Manual schedule overrides — when null the schedule derives from the
  // project start date + cumulative configured durations.
  startDate DateTime?
  endDate   DateTime?

  deliverables ProjectDeliverable[]

  @@index([projectId])
}

model ProjectDeliverable {
  id      String @id @default(cuid())
  phaseId String
  phase   ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)
  status   String @default("PENDING") // PENDING | IN_PROGRESS | DONE
  priority String @default("MEDIUM")  // LOW | MEDIUM | HIGH | CRITICAL

  ownerId String?
  owner   User? @relation("DeliverableOwner", fields: [ownerId], references: [id])

  // Manual schedule overrides — when null the deliverable spans its phase window.
  startDate DateTime?
  endDate   DateTime?

  // Progress + effort (item 4): granular completion and hours tracking.
  progressPct   Int   @default(0) // 0-100; kept coherent with status
  estimateHours Float?
  actualHours   Float?

  // Finish-to-start dependency links (item 3).
  successors   ProjectTaskDependency[] @relation("DepPredecessor")
  predecessors ProjectTaskDependency[] @relation("DepSuccessor")

  @@index([phaseId])
  @@index([ownerId])
}

/// Structured RAID register — risks, assumptions, issues, dependencies —
/// tracked per project with severity, ownership and mitigation.
model ProjectRaidItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type        String  @default("RISK") // RISK | ASSUMPTION | ISSUE | DEPENDENCY
  title       String
  description String? @db.Text
  severity    String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  probability String? // LOW | MEDIUM | HIGH — risks only
  status      String  @default("OPEN") // OPEN | MITIGATING | CLOSED
  mitigation  String? @db.Text

  ownerId String?
  owner   User? @relation("RaidOwner", fields: [ownerId], references: [id])

  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Finish-to-start link between two deliverables of the same project:
/// the successor cannot start before the predecessor ends.
model ProjectTaskDependency {
  id            String @id @default(cuid())
  predecessorId String
  predecessor   ProjectDeliverable @relation("DepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     ProjectDeliverable @relation("DepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          String   @default("FS") // finish-to-start (only type today; column future-proofs SS/FF/SF)
  createdAt     DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

/// Role-based access matrix — one row per (role, module) with CRUD + special
/// action flags. Seeded with sensible defaults on first read; fully editable
/// in Admin → Access. Every employee inherits from their assigned role.
model RolePermission {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   UserRole
  module String // LEADS | OPPORTUNITIES | RFQS | QUOTATIONS | PROJECTS | CUSTOMERS | ACTIVITIES | RATE_CARDS | APPROVALS | REPORTS | ADMIN

  canRead    Boolean @default(true)
  canCreate  Boolean @default(false)
  canUpdate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canCancel  Boolean @default(false)
  canReopen  Boolean @default(false)
  canApprove Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, role, module])
  @@index([organizationId, role])
}

model PipelineGateConfig {
  id             String @id @default(cuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quoteRequiredStage   String? // OpportunityStage value; null = gate disabled
  projectRequiredStage String? // OpportunityStage value; null = gate disabled

  // Project governance (configurable flow restrictions)
  sequentialPhases         Boolean @default(false) // phases must complete in order
  completeRequiresAllPhases Boolean @default(true) // project can't be COMPLETED with open phases

  // Working-day calendar (schedules honor these instead of raw calendar days)
  workingDays String @default("1,2,3,4,5") // ISO weekday numbers, Mon=1 … Sun=7
  holidays    Json?  // array of "yyyy-mm-dd" strings

  // Lifecycle chain validation (all default OFF — the AI quote drafter
  // legitimately creates quotations without an RFQ, so strictness is a choice).
  oppRequiresLead       Boolean @default(false)
  rfqRequiresOpportunity Boolean @default(false)
  quoteRequiresRfq      Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// Localization (i18n) — global, config- & DB-driven. Adding a
// language requires only data (a Language row + TranslationValues),
// never code. UI chrome is app-global (not org-scoped); the per-user
// choice lives on User.uiLanguage / bilingualSecondary.
// -------------------------------------------------------------

enum TextDirection {
  LTR
  RTL
}

/// Lifecycle of a translated value / language pack. Full-language modes are
/// gated on APPROVED + Language.productionReady (see the Arabic review gate).
enum TranslationStatus {
  MISSING       // no value yet — falls back to English source
  MACHINE_DRAFT // provisional (e.g. machine/agent draft) — NOT production-ready
  PENDING_REVIEW// submitted for native-linguist / scholarly review
  APPROVED      // reviewed & approved for production
}

model Language {
  id          String  @id @default(cuid())
  code        String  @unique      // BCP-47 base: "en","ur","ar","hi","fr"…
  name        String               // English display name ("Arabic")
  nativeName  String               // endonym ("العربية")
  direction   TextDirection @default(LTR)
  locale      String               // Intl locale ("ar-SA","ur-PK","en-US")

  enabled         Boolean @default(false) // selectable by users at all
  isDefault       Boolean @default(false) // org/app default UI language
  isFallback      Boolean @default(false) // used when a key is missing
  canBeSecondary  Boolean @default(false) // eligible as a bilingual "beside" script
  canBePrimary    Boolean @default(false) // eligible as a full-UI language
  // Hard gate: a full-UI language may only ship to production when its pack is
  // reviewed & approved. Arabic ships gated (false) until sign-off.
  productionReady Boolean @default(false)
  reviewStatus    TranslationStatus @default(PENDING_REVIEW)

  version   Int @default(1)  // pack version — bumps invalidate client caches
  position  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TranslationNamespace {
  id          String @id @default(cuid())
  name        String @unique       // "common","nav","settings","validation","faith"
  description String?
  // Faith/religious/culturally-sensitive content lives in sensitive namespaces
  // and is never machine-authored — only authoritative, approved imports.
  sensitive   Boolean @default(false)
  version     Int     @default(1)

  keys TranslationKey[]
}

model TranslationKey {
  id          String @id @default(cuid())
  namespaceId String
  namespace   TranslationNamespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)

  key         String  // dot-scoped within the namespace: "dashboard.title"
  sourceText  String  @db.Text // canonical English source (the fallback)
  description String?           // context for translators
  sensitive   Boolean @default(false) // per-key faith/sensitivity flag

  values TranslationValue[]

  @@unique([namespaceId, key])
}

model TranslationValue {
  id           String @id @default(cuid())
  keyId        String
  key          TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  languageCode String
  value        String @db.Text
  status       TranslationStatus @default(MACHINE_DRAFT)
  version      Int    @default(1)
  updatedAt    DateTime @updatedAt

  @@unique([keyId, languageCode])
  @@index([languageCode])
}
